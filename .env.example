# Optional runtime configuration. Copy to .env and fill in.
# Without these the app still runs; Nango integrations report "not configured"
# and Companies House public-data lookups are unavailable.

# Nango secret key (Nango dashboard -> Project Settings -> Environment)
NANGO_SECRET_KEY=

# Companies House public API key (https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=

# Bind address / port (defaults shown)
#BAM_HOST=0.0.0.0
#BAM_PORT=8080

# Never enable on an internet-facing host: Werkzeug debugger = remote code execution.
#BAM_DEBUG=0